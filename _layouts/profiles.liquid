---
layout: page
---
<div class="post">
  <article>
    <!-- Standalone co-authorship graph container -->
    <div
      id="coauthors-graph-wrapper"
      class="mb-5 p-3 border rounded shadow-sm"
      style="background-color: var(--global-bg-color); border-color: var(--global-divider-color) !important;"
    >
      <h4 class="mb-3" style="color: var(--global-theme-color); font-weight: 600;">
        <i class="fas fa-project-diagram mr-2"></i>Co-authorship Network
      </h4>
      <p style="font-size: 0.95rem; color: var(--global-text-color);">
        This force-directed graph visualizes the collaborations with researchers, matching names exactly from my publication record.
      </p>
      <div id="coauthors-graph" style="width: 100%; height: 450px;"></div>
    </div>

    <script
      src="{{ site.third_party_libraries.echarts.url.js.library }}"
      integrity="{{ site.third_party_libraries.echarts.integrity.js.library }}"
      crossorigin="anonymous"
    ></script>
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        var chartDom = document.getElementById('coauthors-graph');
        if (!chartDom) return;
        var myChart = echarts.init(chartDom);
        var data = {{ site.data.coauthors_graph | jsonify }};
        if (!data || !data.nodes) return;

        // Define clean, curated color palettes
        var colors = ['#ff6f61', '#42a5f5'];
        var categories = data.categories.map(function (cat, i) {
          cat.itemStyle = { color: colors[i % colors.length] };
          return cat;
        });

        var option = {
          tooltip: {
            trigger: 'item',
            formatter: function (params) {
              if (params.dataType === 'edge') {
                return params.data.source + ' &harr; ' + params.data.target + ': <b>' + params.data.value + '</b> shared papers';
              }
              return '<b>' + params.data.name + '</b>: ' + params.data.value + ' shared papers';
            }
          },
          legend: [{
            data: categories.map(function (a) {
              return a.name;
            }),
            textStyle: {
              color: 'var(--global-text-color)'
            }
          }],
          animationDurationUpdate: 1500,
          animationEasingUpdate: 'quinticInOut',
          series: [
            {
              type: 'graph',
              layout: 'force',
              data: data.nodes.map(function (node) {
                node.itemStyle = {
                  borderColor: 'var(--global-bg-color)',
                  borderWidth: 2,
                  shadowBlur: 5,
                  shadowColor: 'rgba(0, 0, 0, 0.3)'
                };
                node.label = {
                  show: node.symbolSize > 25,
                  position: 'right',
                  color: 'var(--global-text-color)',
                  fontSize: 12
                };
                return node;
              }),
              links: data.links.map(function (link) {
                link.lineStyle = {
                  color: 'var(--global-theme-color)',
                  width: Math.min(link.value * 2, 8),
                  curveness: 0.1,
                  opacity: 0.6
                };
                return link;
              }),
              categories: categories,
              roam: true,
              labelLayout: {
                hideOverlap: true
              },
              force: {
                repulsion: 300,
                edgeLength: [100, 180],
                gravity: 0.1,
                layoutAnimation: true
              }
            }
          ]
        };

        myChart.setOption(option);

        myChart.on('click', function(params) {
          if (params.dataType === 'node') {
            var authorName = params.data.name;
            var nameToId = {
              'Balachandran Manavalan': 'balachandran',
              'Duc Ngoc Minh Dang': 'dnmduc',
              'Nhat Truong Pham': 'nhattruongpham',
              'Duong Thanh Tran': 'duongttr',
              'Leyi Wei': 'leyiwei',
              'Nam Phuong Tran': 'namphuongtran9196',
              'Trung Thanh Pham': 'trungpt',
              'Hanh Dang-Ngoc': 'hanhdn',
              'Hanh Do Ngoc': 'hanhdn',
              'Cuong Tuan Nguyen': 'cuongnt'
            };

            var clickedId = nameToId[authorName];
            if (!clickedId) {
              var lowerName = authorName.toLowerCase().replace(/[^a-z0-9]/g, '');
              var allProfiles = document.querySelectorAll('.profile');
              allProfiles.forEach(function(p) {
                if (p.id && (lowerName.includes(p.id) || p.id.includes(lowerName))) {
                  clickedId = p.id;
                }
              });
            }

            if (clickedId) {
              var targetElem = document.getElementById(clickedId);
              if (targetElem) {
                targetElem.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          }
        });

        window.addEventListener('resize', function() {
          myChart.resize();
        });
      });
    </script>

    {% if page.profiles %}
      {% for profile in page.profiles %}
        <hr>
        <div
          {% if profile.content %}
            {% assign profile_id = profile.content | split: '/' | last | split: '.' | first %}
            id="{{ profile_id }}"
          {% endif %}
          class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}"
        >
          {% if profile.image %}
            {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
            {% if profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
            {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
          {% endif %}
          {% if profile.more_info %}
            <div class="more-info">{{ profile.more_info }}</div>
          {% endif %}
        </div>

        <div class="clearfix">
          {% if profile.content %}
            {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
            {{ profile_content | markdownify }}
          {% else %}
            {{ content }}
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}
  </article>
</div>
